{
  "name": "foundry-github-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:coverage": "c8 --all --include \"apps/github-app/src/**/*.ts\" --extension .ts --reporter text --check-coverage --lines 95 node --test \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "dev:gateway": "node apps/github-app/src/dev.ts",
    "dev:migrate": "node apps/github-app/src/migrate-dev.ts",
    "dev:dispatch": "node apps/github-app/src/dev-dispatch.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-config.mjs"
  },
  "dependencies": {
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "ajv": "^8.17.1",
    "c8": "^12.0.0",
    "typescript": "^5.9.0",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "test-exclude": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.8"
    }
  }
}
