{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/foundryops/schemas/task/2-0-0",
  "title": "Autonomous implementation task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "story", "objective", "phase", "primaryAgent", "allowedPaths", "forbiddenPaths", "inputs", "acceptanceCriteria", "requiredChecks", "security", "completionEvidence"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z0-9]+-[0-9]+$"},
    "story": {"type": "string", "pattern": "^US-[A-Z][0-9]{2}$"},
    "objective": {"type": "string", "minLength": 10, "pattern": "\\S"},
    "phase": {"type": "integer", "minimum": 0, "maximum": 9},
    "primaryAgent": {"enum": ["solution-architect", "foundry-sdk-expert", "github-sdk-expert", "github-automation", "github-app-logic", "python-code", "yaml-config", "testing-expert", "security-expert", "ui-ux-expert", "documentation-expert", "e2e-validation"]},
    "reviewAgents": {"type": "array", "uniqueItems": true, "items": {"enum": ["project-orchestrator", "solution-architect", "foundry-sdk-expert", "github-sdk-expert", "github-automation", "github-app-logic", "python-code", "yaml-config", "testing-expert", "security-expert", "ui-ux-expert", "documentation-expert", "e2e-validation"]}},
    "allowedPaths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonBlank"}},
    "forbiddenPaths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonBlank"}},
    "inputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonBlank"}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonBlank"}},
    "acceptanceCriteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5, "pattern": "\\S"}},
    "requiredChecks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonBlank"}},
    "security": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonBlank"}},
    "completionEvidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonBlank"}},
    "maxRepairAttempts": {"type": "integer", "minimum": 0, "maximum": 2, "default": 2}
  },
  "$defs": {
    "nonBlank": {"type": "string", "pattern": "\\S"}
  }
}
